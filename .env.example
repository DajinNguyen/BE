# DB 접속 주소 (비워두면 로컬 SQLite 파일 dajin.db 사용)
DATABASE_URL=postgresql+psycopg://dajin:dajin@localhost:5432/dajin

# AI 리포트 생성용 Anthropic API 키 (설정되면 이게 최우선으로 쓰임)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# AI 리포트 생성용 Gemini API 키 (Anthropic 키가 없을 때 이걸 씀)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 위 둘 다 비어있으면 app/data/report_samsung.json 목데이터를 돌려줌 (데모용, 삼성전자만)

# OpenDART(금융감독원 전자공시) 인증키 — 회사 고유번호·공식 회사명·홈페이지를 채워요
# 비어있으면 app/data 시드 데이터만 써요. 발급: https://opendart.fss.or.kr
DART_API_KEY=

# 네이버 금융 시세(비공식 API, 키 없음) — 현재가·등락률·거래대금·시가총액·주가 흐름
# false면 시드 예시 값(is_sample: true)만 써요
NAVER_PRICES_ENABLED=true

# Google 로그인 (OAuth 클라이언트: Google Cloud Console → API 및 서비스 → 사용자 인증 정보)
# 승인된 리디렉션 URI에 GOOGLE_REDIRECT_URI 값을 그대로 등록해야 해요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# 로그인 쿠키(JWT) 서명 키. 비워 두면 서버를 켤 때마다 바뀌어서 재시작하면 로그아웃돼요
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# https로 배포하면 true
COOKIE_SECURE=false
