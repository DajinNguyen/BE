# 복사해서 deploy/.env 로 만들고 채우세요:  cp .env.example .env
# ⚠️ .env 는 절대 git 에 올리지 마세요 (비밀번호·키가 들어 있어요)

# ── 필수 ──────────────────────────────────────────────
# 서비스 주소 (https:// 없이 도메인만). 예: dajin.example.com
DOMAIN=

# DB 비밀번호 (아무 긴 문자열. 한 번 정하면 바꾸지 마세요)
POSTGRES_PASSWORD=

# 로그인 쿠키 서명 키 (32자 이상).
# 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Google 로그인 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare 터널 토큰 (Cloudflare Zero Trust → Networks → Tunnels 에서 만든 뒤 복사)
CLOUDFLARE_TUNNEL_TOKEN=

# ── AI (둘 중 하나는 있어야 AI 리포트가 진짜로 나와요) ──────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 데이터 ────────────────────────────────────────────
DART_API_KEY=
# 네이버 검색 API (뉴스). 비우면 Google 뉴스 RSS (비상업 용도만 허용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# ⚠️ 네이버 금융 시세는 비공식 API라 상업 서비스에는 쓰면 안 돼요. 베타 테스트 동안만 true 로 두세요
NAVER_PRICES_ENABLED=true
